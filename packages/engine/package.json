{
    "name": "@comptasse/fec-engine",
    "type": "module",
    "private": true,
    "scripts": {
        "build": "tsc --build",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@types/node": "26.6.1",
        "jsdom": "30.1.0",
        "typescript": "7.0.2",
        "vitest": "5.0.1"
    },
    "dependencies": {
        "nanoid": "6.0.1",
        "valibot": "1.5.0"
    },
    "exports": {
        ".": {
            "source": "./src/index.ts",
            "types": "./build/index.d.ts",
            "default": "./build/index.js"
        },
        "./utilities": {
            "source": "./src/utilities/index.ts",
            "types": "./build/utilities/index.d.ts",
            "default": "./build/utilities/index.js"
        },
        "./fec": {
            "source": "./src/fec/index.ts",
            "types": "./build/fec/index.d.ts",
            "default": "./build/fec/index.js"
        }
    }
}
